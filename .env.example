# URL pública da aplicação (usada por metadata, links absolutos e chamadas externas)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de desenvolvimento (sobe junto com o docker-compose)
DATABASE_URL=postgresql://busaum:busaum@localhost:5432/busaum_dev

# Banco usado pelos testes de integração (mesmo container, database separado)
TEST_DATABASE_URL=postgresql://busaum:busaum@localhost:5432/busaum_test

# Anexos (atestados, comprovantes). Sem o token, ficam em ./uploads (desenvolvimento).
# Em produção a Vercel injeta este token ao conectar um Blob store ao projeto.
# BLOB_READ_WRITE_TOKEN=
